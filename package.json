{
  "name": "lofi-data-prep",
  "version": "0.2.0",
  "description": "Desktop LoRA dataset preparation with recoverable file operations and vision API captioning.",
  "productName": "Lofi Data Prep",
  "appId": "com.lofi.dataprep",
  "author": "Lofi",
  "license": "CC-BY-NC-4.0",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "check": "eslint .",
    "build": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "install:electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0"
  },
  "build": {
    "appId": "com.lofi.dataprep",
    "productName": "Lofi Data Prep",
    "files": [
      "main.js",
      "preload.js",
      "actions/**/*",
      "lib/**/*",
      "renderer/**/*",
      "package.json",
      "License"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "JustLateNightAI"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lofi Data Prep"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
